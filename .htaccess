# Glovels — generated by build_pages.py
# PREVIEW build

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Anchors the rules to this folder. Without it, a staging copy in /Test would
  # redirect to the domain root and every page would 404.
  RewriteBase /

  # Serve /study-in-germany from study-in-germany.html, with no redirect and no
  # trailing slash — the exact addresses the live site ranks on today.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # If anyone reaches a .html address directly, send them to the clean one, so
  # the same page is never indexed at two URLs.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # A preview build is served from a subdomain, so no canonical redirect here.

  # Old URLs from the previous site go here as 301s, one per line, so existing
  # search rankings do not land on a 404:
  # Redirect 301 /old-page.php /study-in-germany
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # HTML stays short so a rebuild is visible straight away; assets can cache hard.
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# The enquiry log holds personal data and must never be served.
<Files "enquiries.log">
  Require all denied
</Files>
